# Runtime
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ravenfold

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_LOGIN_THROTTLE_MAX_ATTEMPTS=5
AUTH_LOGIN_THROTTLE_WINDOW_MS=900000
AUTH_LOGIN_THROTTLE_LOCKOUT_MS=1800000
PASSWORD_RESET_TOKEN_TTL_MS=1800000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# Image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ravenfold/products
CLOUDINARY_REVIEW_UPLOAD_FOLDER=ravenfold/reviews

# Promotions
PROMOTION_NEW_USER_ELIGIBILITY_DAYS=30

# Background jobs
ENABLE_PAYMENT_RECONCILIATION_JOBS=false
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_MIN_AGE_MS=300000
PAYMENT_RECONCILIATION_BATCH_SIZE=25

ENABLE_UNPAID_ORDER_EXPIRY_JOBS=false
UNPAID_ORDER_EXPIRY_INTERVAL_MS=900000
UNPAID_ORDER_EXPIRY_MINUTES=30
UNPAID_ORDER_EXPIRY_BATCH_SIZE=25

ENABLE_REVIEW_REMINDER_JOBS=false
REVIEW_REMINDER_DELAY_DAYS=3
REVIEW_REMINDER_JOB_INTERVAL_MS=3600000
REVIEW_REMINDER_MAX_ATTEMPTS=3
REVIEW_REMINDER_BATCH_SIZE=25
REVIEW_REMINDER_EMAIL_MODE=log

# Payments
PAYMENT_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Legacy/optional S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Shipping
SHIPPING_DEFAULT_PROVIDER=manual
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_SECRET=

DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_TOKEN=
DELHIVERY_PICKUP_LOCATION=
