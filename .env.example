# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ravenfold

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_LOGIN_THROTTLE_MAX_ATTEMPTS=5
AUTH_LOGIN_THROTTLE_WINDOW_MS=900000
AUTH_LOGIN_THROTTLE_LOCKOUT_MS=1800000
PASSWORD_RESET_TOKEN_TTL_MS=1800000

# Rate limits
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_CHECKOUT_WINDOW_MS=900000
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_PAYMENT_WINDOW_MS=900000
RATE_LIMIT_PAYMENT_MAX=40
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120

# Transactional email
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@ravenfold.local
EMAIL_FROM_NAME=Raven Fold
EMAIL_REPLY_TO_ADDRESS=
EMAIL_REPLY_TO_NAME=Raven Fold
EMAIL_REQUEST_TIMEOUT_MS=10000
ZEPTO_MAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTO_MAIL_SEND_TOKEN=

# OAuth
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# Image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ravenfold/products
CLOUDINARY_REVIEW_UPLOAD_FOLDER=ravenfold/reviews
CLOUDINARY_CATEGORY_UPLOAD_FOLDER=ravenfold/categories
CLOUDINARY_GST_UPLOAD_FOLDER=ravenfold/gst

# Promotions
PROMOTION_NEW_USER_ELIGIBILITY_DAYS=30

# Background jobs
ENABLE_PAYMENT_RECONCILIATION_JOBS=false
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_MIN_AGE_MS=300000
PAYMENT_RECONCILIATION_BATCH_SIZE=25
ENABLE_UNPAID_ORDER_EXPIRY_JOBS=false
UNPAID_ORDER_EXPIRY_INTERVAL_MS=900000
UNPAID_ORDER_EXPIRY_MINUTES=30
UNPAID_ORDER_EXPIRY_BATCH_SIZE=25
ENABLE_REVIEW_REMINDER_JOBS=false
REVIEW_REMINDER_DELAY_DAYS=3
REVIEW_REMINDER_JOB_INTERVAL_MS=3600000
REVIEW_REMINDER_MAX_ATTEMPTS=3
REVIEW_REMINDER_BATCH_SIZE=25

# Payments
PAYMENT_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping
SHIPPING_DEFAULT_PROVIDER=manual
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_SECRET=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_TOKEN=
DELHIVERY_PICKUP_LOCATION=
